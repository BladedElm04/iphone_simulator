{
  "name": "iphone-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source iPhone-inspired environment for web application testing.",
  "license": "MIT",
  "main": "apps/desktop/electron.cjs",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "vite --host 0.0.0.0",
    "dev:desktop": "concurrently -k --success last \"vite --host 0.0.0.0 --port 5174\" \"wait-on http://localhost:5174 && electron apps/desktop/electron.cjs\"",
    "build:web": "tsc --noEmit && vite build",
    "build:desktop": "pnpm build:web && electron-builder",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "setup:webkit": "playwright install webkit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "playwright": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.iphonesimulator.desktop",
    "productName": "iPhone Simulator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "apps/desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
